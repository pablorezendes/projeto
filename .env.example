# Copie para .env e use exatamente os nomes da configuração Traefik existente.
# Este arquivo não contém senhas. .env fica fora do Git e da imagem Docker.
TRAEFIK_NETWORK=
TRAEFIK_HTTP_ENTRYPOINT=
TRAEFIK_HTTPS_ENTRYPOINT=
TRAEFIK_CERTRESOLVER=

